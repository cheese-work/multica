{
  "version": 1,
  "plugins": [
    {
      "name": "ci-wait",
      "match": {
        "tool": "gh"
      },
      "action": "deny",
      "builtin": "ci-wait"
    },
    {
      "name": "ci-wait-sleep",
      "match": {
        "tool": "sleep"
      },
      "action": "deny",
      "builtin": "ci-wait"
    },
    {
      "name": "gh-pr",
      "match": {
        "tool": "gh",
        "subcommand": [
          "pr"
        ]
      },
      "action": "fix",
      "builtin": "gh-pr"
    },
    {
      "name": "gh-api",
      "match": {
        "tool": "gh",
        "subcommand": [
          "api"
        ]
      },
      "action": "deny",
      "builtin": "gh-api"
    },
    {
      "name": "wakeup-create",
      "match": {
        "tool": "multica",
        "subcommand": [
          "issue",
          "wakeup",
          "create"
        ]
      },
      "action": "shadow",
      "builtin": "multica-wakeup"
    },
    {
      "name": "wakeup-update",
      "match": {
        "tool": "multica",
        "subcommand": [
          "issue",
          "wakeup",
          "update"
        ]
      },
      "action": "shadow",
      "builtin": "multica-wakeup"
    }
  ],
  "repository_allowlist": {
    "tevo-studio": [
      "ap004-duo-app",
      "ap006-dramajoy",
      "ap007-zonamatch-3",
      "ap008-vpn",
      "code-android-template",
      "code-android-template-fork",
      "ev001-weather-native",
      "ev004-datingly",
      "ev005-blood-sugar",
      "ev008-short-drama-1",
      "EVL003-Quran",
      "mMonetize",
      "mMonetize-sample",
      "playevo-mobile-sdk",
      "sa004-vpn",
      "sa010-earth-map",
      "sa039-astrology",
      "sa042-vpn-4",
      "sa053-Browser-3",
      "sa056-zonamatch",
      "sa065-emoji",
      "sa067-4k-parallax-wallpaper",
      "sa070-Ar-Drawing",
