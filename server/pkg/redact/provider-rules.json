[
  {
    "note": "AWS access key IDs (always start with AKIA)",
    "pattern": "\\bAKIA[0-9A-Z]{16}\\b",
    "flags": "",
    "replacement": "[REDACTED AWS KEY]"
  },
  {
    "note": "AWS secret access keys (40 char base64-ish, preceded by a common separator)",
    "pattern": "(?:aws_secret_access_key|secret_?access_?key)\\s*[=:]\\s*[A-Za-z0-9/+=]{40}",
    "flags": "i",
    "replacement": "[REDACTED AWS SECRET]"
  },
  {
    "note": "PEM private keys (multi-line)",
    "pattern": "-----BEGIN[A-Z\\s]*PRIVATE KEY-----.*?-----END[A-Z\\s]*PRIVATE KEY-----",
    "flags": "s",
    "replacement": "[REDACTED PRIVATE KEY]"
  },
  {
    "note": "GitHub tokens (classic PAT, OAuth, user-to-server, server-to-server, refresh)",
    "pattern": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9_]{36,255}\\b",
    "flags": "",
    "replacement": "[REDACTED GITHUB TOKEN]"
  },
  {
    "note": "GitHub fine-grained personal access tokens (github_pat_ prefix)",
    "pattern": "\\bgithub_pat_[A-Za-z0-9_]{20,255}\\b",
    "flags": "",
    "replacement": "[REDACTED GITHUB TOKEN]"
  },
  {
    "note": "OpenAI / Anthropic API keys",
    "pattern": "\\bsk-[A-Za-z0-9_-]{20,}\\b",
    "flags": "",
    "replacement": "[REDACTED API KEY]"
  },
  {
    "note": "Slack bot/user/legacy tokens; the class includes e for xoxe- config/refresh tokens",
    "pattern": "\\bxox[bporase]-[A-Za-z0-9\\-]{10,}\\b",
    "flags": "",
    "replacement": "[REDACTED SLACK TOKEN]"
  },
  {
    "note": "Slack app-level tokens (xapp- prefix)",
    "pattern": "\\bxapp-[A-Za-z0-9-]{10,}\\b",
    "flags": "",
    "replacement": "[REDACTED SLACK TOKEN]"
  },
  {
    "note": "GitLab personal access tokens",
    "pattern": "\\bglpat-[A-Za-z0-9_-]{20,}\\b",
    "flags": "",
    "replacement": "[REDACTED GITLAB TOKEN]"
  },
  {
    "note": "Google API keys (AIza + 35 chars); the trailing delimiter is captured and restored so keys ending in - are still redacted",
    "pattern": "\\bAIza[0-9A-Za-z_-]{35}([^0-9A-Za-z_-]|$)",
    "flags": "",
    "replacement": "[REDACTED GOOGLE API KEY]$1"
  },
  {
    "note": "Stripe secret / restricted live keys; publishable pk_live_ keys are not secret and stay",
    "pattern": "\\b(?:sk|rk)_live_[0-9A-Za-z]{16,}\\b",
    "flags": "",
    "replacement": "[REDACTED STRIPE KEY]"
  },
  {
    "note": "JWT tokens (three base64url segments)",
    "pattern": "\\bey[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b",
    "flags": "",
    "replacement": "[REDACTED JWT]"
  },
  {
    "note": "Generic Bearer <token> in output; no trailing boundary so = padding is redacted too",
    "pattern": "\\bBearer\\s+[A-Za-z0-9\\-._~+/]+=*",
    "flags": "i",
    "replacement": "Bearer [REDACTED]"
  },
  {
    "note": "Connection strings with embedded passwords",
    "pattern": "(?:postgres|mysql|mongodb|redis|amqp)(?:ql)?://[^:\\s]+:[^@\\s]+@",
    "flags": "i",
    "replacement": "[REDACTED CONNECTION STRING]@"
  }
]
