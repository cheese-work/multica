# CD backend image built from binaries the CI runner already compiled
# (scripts/build-cd-backend-binaries.sh, CHE-7209). The runtime stage is the
# runtime stage of Dockerfile; only the source of the binaries differs.
#
# Build with a named context holding the binaries and SHA256SUMS:
#   docker buildx build --file Dockerfile.cd-backend \
#     --build-context cdbin=<dir> --build-arg CD_BINARIES_SHA256=<sha256 of SHA256SUMS> \
#     --build-arg COMMIT=<sha> .

# --- Verify stage: nothing reaches the image unless it matches SHA256SUMS.
# Modes are then set to 755 (binaries) and 644 (manifest.json), so the runner
# umask cannot change the image. ---
FROM alpine:3.21 AS verify

ARG CD_BINARIES_SHA256
ARG COMMIT

WORKDIR /cdbin
COPY --from=cdbin . .
RUN test -n "$CD_BINARIES_SHA256" && test -n "$COMMIT" \
    && echo "${CD_BINARIES_SHA256}  SHA256SUMS" | sha256sum -c - \
    && sha256sum -c SHA256SUMS \
    && find . -type f ! -name SHA256SUMS | sed 's|^\./||' | LC_ALL=C sort > /tmp/found \
    && awk '{print $2}' SHA256SUMS | LC_ALL=C sort | diff - /tmp/found \
    && grep -F "\"commit\":\"${COMMIT}\"" daemon-binaries/manifest.json \
    && find . -type d -exec chmod 755 {} + \
    && find . -type f -exec chmod 644 {} + \
    && find . -type f ! -name manifest.json ! -name SHA256SUMS -exec chmod 755 {} +

# --- Runtime stage ---
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

COPY --from=verify /cdbin/server .
COPY --from=verify /cdbin/multica .
COPY --from=verify /cdbin/daemon-binaries ./daemon-binaries
COPY --from=verify /cdbin/migrate .
COPY --from=verify /cdbin/maintenance .
COPY --from=verify /cdbin/backfill_task_usage_hourly .
COPY --from=verify /cdbin/backfill_codex_usage_cache .
COPY server/migrations/ ./migrations/
COPY LICENSE NOTICE ./
COPY docker/entrypoint.sh docker/entrypoint.cd.sh .
RUN sed -i 's/\r$//' entrypoint.sh entrypoint.cd.sh && chmod +x entrypoint.sh entrypoint.cd.sh

EXPOSE 8080

ENTRYPOINT ["./entrypoint.sh"]
