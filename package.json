{
  "name": "multica",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "turbo dev --filter=@multica/web",
    "dev:docs": "turbo dev --filter=@multica/docs",
    "dev:desktop": "turbo dev --filter=@multica/desktop",
    "dev:desktop:staging": "turbo dev:staging --filter=@multica/desktop",
    "dev:mobile": "pnpm -C apps/mobile dev",
    "dev:mobile:staging": "pnpm -C apps/mobile dev:staging",
    "dev:mobile:prod": "pnpm -C apps/mobile dev:prod",
    "ios:mobile": "pnpm -C apps/mobile ios",
    "ios:mobile:staging": "pnpm -C apps/mobile ios:staging",
    "ios:mobile:prod": "pnpm -C apps/mobile ios:prod",
    "ios:mobile:device": "pnpm -C apps/mobile ios:device",
    "ios:mobile:device:staging": "pnpm -C apps/mobile ios:device:staging",
    "ios:mobile:device:staging:release": "pnpm -C apps/mobile ios:device:staging:release",
    "ios:mobile:device:prod": "pnpm -C apps/mobile ios:device:prod",
    "ios:mobile:device:prod:release": "pnpm -C apps/mobile ios:device:prod:release",
    "build": "turbo build --filter=!@multica/mobile",
    "typecheck": "turbo typecheck --filter=!@multica/mobile",
    "test": "turbo test --filter=!@multica/mobile",
    "lint": "turbo lint --filter=!@multica/mobile",
    "knip": "knip",
    "check:ui-exports": "node scripts/check-ui-wildcard-exports.mjs",
    "check:ui-radii": "node scripts/check-ui-radius-tokens.mjs",
    "clean": "turbo clean && rm -rf node_modules",
    "ui:add": "cd packages/ui && npx shadcn@latest add",
    "changelog:preview": "node scripts/fork-changelog.mjs --fixture scripts/fixtures/fork-changelog-preview.json --out .fork-changelog/preview.json",
    "generate:attachment-text-preview": "node scripts/generate-attachment-text-preview.mjs",
    "generate:reserved-slugs": "node scripts/generate-reserved-slugs.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "msw",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "core-js",
      "electron-winstaller",
      "protobufjs",
      "sharp",
      "unicode-animations"
    ],
    "overrides": {
      "@types/react": "catalog:",
      "@types/react-dom": "catalog:",
      "@xmldom/xmldom": "^0.8.15",
      "postcss": "8.5.26",
      "@tailwindcss/node>lightningcss": "1.33.0",
      "uuid": "11.1.1",
      "shell-quote": "1.12.0",
      "proxy-addr@<2.0.8": "2.0.8",
      "tar@>=7.0.0 <7.5.19": "7.5.22",
      "minimatch@3>brace-expansion": "1.1.21",
      "minimatch@5>brace-expansion": "2.1.7",
      "minimatch@9>brace-expansion": "2.1.7",
      "minimatch@10>brace-expansion": "5.0.12",
      "builder-util-runtime": "9.7.0",
      "@modelcontextprotocol/sdk@<1.32.0": "^1.32.2",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "browserslist@>=4.0.0 <4.28.7": "^4.28.7",
      "fast-uri@>=3.0.0 <3.1.7": "^3.1.9",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "glob@>=10.0.0 <10.5.0": "^10.5.0",
      "hono@>=4.0.0 <4.12.25": "^4.13.17",
      "ip-address@>=10.0.0 <10.3.1": "^10.7.6",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "path-to-regexp@>=8.0.0 <8.4.0": "^8.4.2",
      "picomatch@>=2.0.0 <2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.7",
      "react-router@>=7.0.0 <7.18.2": "^7.18.5",
      "source-map-js@<1.2.2": "^1.2.2",
      "tmp@<0.2.6": "^0.2.7",
      "undici@>=7.0.0 <7.30.1": "^7.30.2",
      "vite@>=8.0.0 <8.1.6": "^8.3.6",
      "compression@<1.8.2": "^1.8.2",
      "dompurify@<3.4.17": "^3.4.17",
      "image-size@<2.0.3": "^2.0.3",
      "node-forge@<1.4.1": "^1.4.3",
      "protobufjs@<7.6.1": "^7.6.1",
      "ws@>=7.0.0 <7.5.11": "^7.5.11",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "zod@>=4.0.0 <4.6.6": "^4.6.6",
      "expo-modules-core": "57.0.24"
    },
    "patchedDependencies": {
      "expo-modules-core@57.0.24": "apps/mobile/patches/expo-modules-core@57.0.24.patch",
      "decode-uri-component@0.2.2": "patches/decode-uri-component@0.2.2.patch"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "knip": "^6.32.2",
    "pg": "^8.20.0",
    "turbo": "^2.5.4",
    "typescript": "catalog:"
  }
}
